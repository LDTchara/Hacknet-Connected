<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>11</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>CS8500</NoWarn>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="HacknetHotReplace-master\**" />
    <Compile Remove="HacknetServerTerminal\**" />
    <Compile Remove="ServerClientEventsMod\**" />
    <Compile Remove="ServerConsole\**" />
    <Compile Remove="TAXCore Online\**" />
    <Compile Remove="TestClient\**" />
    <Compile Remove="hacknet-re\**" />
    <EmbeddedResource Remove="HacknetHotReplace-master\**" />
    <EmbeddedResource Remove="HacknetServerTerminal\**" />
    <EmbeddedResource Remove="ServerClientEventsMod\**" />
    <EmbeddedResource Remove="ServerConsole\**" />
    <EmbeddedResource Remove="TAXCore Online\**" />
    <EmbeddedResource Remove="TestClient\**" />
    <EmbeddedResource Remove="hacknet-re\**" />
    <None Remove="HacknetHotReplace-master\**" />
    <None Remove="HacknetServerTerminal\**" />
    <None Remove="ServerClientEventsMod\**" />
    <None Remove="ServerConsole\**" />
    <None Remove="TAXCore Online\**" />
    <None Remove="TestClient\**" />
    <None Remove="hacknet-re\**" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>libs\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Core">
      <HintPath>libs\BepInEx.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Hacknet">
      <HintPath>libs\BepInEx.Hacknet.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>libs\FNA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Hacknet">
      <HintPath>libs\HacknetPathfinder.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>libs\Mono.Cecil.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.RuntimeDetour">
      <HintPath>libs\MonoMod.RuntimeDetour.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MonoMod.Utils">
      <HintPath>libs\MonoMod.Utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="PathfinderAPI">
      <HintPath>libs\PathfinderAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ServerClientEventsMod">
      <HintPath>..\ServerClientEventsMod\bin\Debug\net472\ServerClientEventsMod.dll</HintPath>
    </Reference>

  </ItemGroup>

</Project>
