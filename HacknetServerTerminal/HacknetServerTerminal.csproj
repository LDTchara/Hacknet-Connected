<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputPath>..\Output\Terminal\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Example\**" />
    <EmbeddedResource Remove="Example\**" />
    <None Remove="Example\**" />
  </ItemGroup>

  <!-- 准备大厅协议：和 ServerPlugin / ClientPlugin 共用同一份源码 -->
  <ItemGroup>
    <Compile Include="..\Shared\Lobby\LobbyProtocol.cs" Link="Lobby\LobbyProtocol.cs" />
    <Compile Include="..\Shared\Pause\PauseProtocol.cs" Link="Lobby\PauseProtocol.cs" />
    <Compile Include="..\Shared\Teams\TeamProtocol.cs" Link="Lobby\TeamProtocol.cs" />
    <Compile Include="..\Shared\NodeSync\NodeProtocol.cs" Link="Lobby\NodeProtocol.cs" />
    <Compile Include="..\Shared\Flags\FlagProtocol.cs" Link="Lobby\FlagProtocol.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiteNetLib" Version="1.3.5" />
  </ItemGroup>

</Project>
